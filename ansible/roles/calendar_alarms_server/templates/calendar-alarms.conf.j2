server {
    listen {{ calendar_alarms_https_port }} ssl;
    listen [::]:{{ calendar_alarms_https_port }} ssl;
    server_name nas.dixon.net.au;

    # --- SSL certificates ---
    ssl_certificate     /etc/nginx/ssl/nas.dixon.net.au.pem;
    ssl_certificate_key /etc/nginx/ssl/nas.dixon.net.au-key.pem;

    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers HIGH:!aNULL:!MD5;
    ssl_prefer_server_ciphers on;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 10m;

    # Normal API/HTTP traffic
    location / {
        proxy_pass http://127.0.0.1:{{ calendar_alarms_http_port }};
        proxy_http_version 1.1;

        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # SSE endpoint — needs no buffering + long-lived connection
    location /api/events {
        proxy_pass http://127.0.0.1:{{ calendar_alarms_http_port }};
        proxy_http_version 1.1;

        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # Critical for SSE: disable buffering so events flush immediately
        proxy_buffering off;
        proxy_cache off;

        # Keep the connection alive indefinitely (SSE is long-lived)
        proxy_read_timeout 24h;
        proxy_send_timeout 24h;

        # Some setups also need this to avoid gzip breaking chunked SSE
        gzip off;

        # Recommended by some proxies to prevent connection reuse issues,
        # though usually not needed with HTTP/1.1 keepalive to a single upstream
        chunked_transfer_encoding on;
    }
}
