[Unit]
Description=Calendar Alarms School Announcements Timer

[Timer]
# Fires 1 minute before the 8:30am announcement time, so play_school_announcements has time to
# build the audio file before sleeping until the exact moment to play it (see timer.py LEAD_TIME).
OnCalendar=Mon..Fri *-*-* 08:29:00 Australia/Melbourne
Unit=calendar-alarms-school-announcements.service
Persistent=false

[Install]
WantedBy=timers.target
