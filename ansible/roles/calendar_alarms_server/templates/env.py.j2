WAKE_UP_ALARMS_DIRECTORY = "{{ wake_up_alarms_directory }}"
SOUND_EFFECTS_DIRECTORY = "{{ sound_effects_directory }}"
CALENDAR_DATA_DIRECTORY = "{{ calendar_data_directory }}"
CACHE_DIRECTORY = "{{ cache_directory }}"

ANNOUNCEMENT_SOUND_EFFECT_PROBABILITY = 2/3
DEFAULT_GOOGLE_TRANSLATE_TLD = "com.au"
GOOGLE_TRANSLATE_LANG = "en"
LOG_LEVEL = "DEBUG"
APP_NAME = "{{ app_name }}"

HOME_ASSISTANT_SUPPORTED = {{ home_assistant_supported }}
HOUSIE_TALKIE_ENABLED = {{ housie_talkie_enabled }}
WAKE_UP_ALARM_ENABLED = {{ wake_up_alarm_enabled }}
SNAPCAST_ENABLED = {{ snapcast_enabled }}

TIMEZONE = "Australia/Melbourne"
SYSTEMD_USER_DIR = "/home/{{ ansible_user }}/.config/systemd/user"

# How often to check for and play notifications
NOTIFICATIONS_CHECK_INTERVAL_MINUTES = {{ NOTIFICATIONS_CHECK_INTERVAL_MINUTES }}
# How many seconds before each notification tick the daemon wakes up to prepare notification audio,
# so playback can start exactly on the tick instead of after however long that build takes.
NOTIFICATIONS_PREPARATION_LEAD_TIME_SECONDS = {{ notifications_preparation_lead_time_seconds }}

CALENDAR_DATA_REFRESH_INTERVAL_MINUTES = {{ calendar_data_refresh_interval_minutes }}
CALENDAR_DATA_REFRESH_OFFSET_SECONDS = {{ calendar_data_refresh_offset_seconds }}
